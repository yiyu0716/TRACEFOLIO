# Copy this file to .env in services/cloud. Never commit the filled file.
TRACEFOLIO_CLOUD_DATABASE_URL="postgresql://tracefolio:replace-me@127.0.0.1:5432/tracefolio"
TRACEFOLIO_CLOUD_HOST="127.0.0.1"
TRACEFOLIO_CLOUD_PORT="4310"
TRACEFOLIO_REGISTRATION_CODE="replace-with-a-random-invitation-code"

# Generate independently: openssl rand -hex 32. Back up securely.
TRACEFOLIO_STORAGE_KEY=""
# local is for development only. Production: quark-webdav.
TRACEFOLIO_STORAGE_DRIVER="local"
TRACEFOLIO_STORAGE_DIR=".cloud-data/objects"
# Private WebDAV mount backed by Quark, e.g. OpenList /dav/tracefolio/.
# Enable proxy downloads, not HTTP 302 redirects. Bridge credentials stay server-side.
TRACEFOLIO_QUARK_WEBDAV_URL="https://your-private-bridge.example/dav/tracefolio/"
TRACEFOLIO_QUARK_WEBDAV_USER="tracefolio-service"
TRACEFOLIO_QUARK_WEBDAV_PASSWORD=""

# Prices/allowances are operator-defined, not claims about current provider prices.
# Use one-line JSON. Model API keys must exist only on this server.
# TRACEFOLIO_MODELS_JSON='[{"id":"platform-model","label":"平台模型","upstreamModel":"YOUR_MODEL","baseUrl":"https://YOUR_PROVIDER/v1","apiKey":"YOUR_SERVER_KEY","protocol":"responses","maxOutputTokens":4096,"maxRequestBytes":256000,"inputUnitsPerMillion":1000,"outputUnitsPerMillion":3000}]'
# TRACEFOLIO_PRODUCTS_JSON='[{"id":"bundle-month","name":"Agent + 平台模型月费","kind":"bundle","term":"month","modelDays":31,"allowanceUnits":100000,"storageBytes":104857600,"models":["platform-model"],"priceLabel":"请配置实际价格"},{"id":"agent-month","name":"Agent 月费","kind":"agent","term":"month","storageBytes":104857600},{"id":"agent-year","name":"Agent 年费","kind":"agent","term":"year","storageBytes":104857600},{"id":"agent-lifetime","name":"Agent 永久","kind":"agent","term":"lifetime","storageBytes":104857600}]'
