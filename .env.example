# Modified for TRACEFOLIO (2026). Prefer `npm run setup` to generate .env.
DATABASE_URL="file:./dev.db"
# Generate a random secret. The upstream variable name is retained for compatibility.
LUJIE_SETTINGS_SECRET=""

# Optional first-run defaults. Configure the API key from the Settings page.
OPENAI_BASE_URL="https://api.deepseek.com/v1"
OPENAI_MODEL="deepseek-flash"

# Codex app-server tasks and optional evidence review. Both are required.
# Never use a GitHub PAT here. Credentials stay on the server.
TRACEFOLIO_CODEX_API_KEY=""
TRACEFOLIO_CODEX_MODEL=""
# Optional Responses-compatible endpoint for app-server tasks (validate compatibility).
# This does not change the older SDK evidence-review endpoint.
TRACEFOLIO_CODEX_BASE_URL=""
TRACEFOLIO_CODEX_TIMEOUT_MS="180000"
